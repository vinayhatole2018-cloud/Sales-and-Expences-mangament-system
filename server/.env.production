# API server settings for the real Firebase project.
# The service-account key file is a SECRET: keep it only on this computer / the
# server, never in git (service-account*.json is git-ignored).
PORT=4001
CORS_ORIGIN=http://localhost:5173,https://publish-management-syste-63f32.web.app,https://publish-management-syste-63f32.firebaseapp.com
USE_FIREBASE_EMULATORS=false
FIREBASE_PROJECT_ID=publish-management-syste-63f32
FIREBASE_STORAGE_BUCKET=publish-management-syste-63f32.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
NODE_ENV=production
ENABLE_JOBS=true
