# ---------------------------------------------------------------------------
# API server configuration. Copy to server/.env and adjust.
# ---------------------------------------------------------------------------

PORT=4001
# Comma separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# --- Local development with the Firebase Emulator Suite (npm run emulators) ---
USE_FIREBASE_EMULATORS=true
FIREBASE_PROJECT_ID=demo-pbms
FIREBASE_STORAGE_BUCKET=demo-pbms.appspot.com

# --- Production (real Firebase project) ---
# Set USE_FIREBASE_EMULATORS=false and provide credentials with ONE of:
#   GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#   FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 of the service account JSON>
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Requests per IP per 15 minutes.
RATE_LIMIT_MAX=1500
# Run background jobs (deadline reminders, scheduled backups) in this process.
ENABLE_JOBS=true
