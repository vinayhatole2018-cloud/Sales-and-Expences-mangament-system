# Production web app settings.
# Sign-in and all data go through the API server, which uses the Firebase
# project "publish-management-syste-63f32" (Firestore + Storage). The browser
# does not load the Firebase SDK, so no Firebase keys are needed here.

# API base URL. Empty = same origin (Vite proxy locally, or a Hosting rewrite
# to the API in production). Set it if the API runs on another domain.
VITE_API_URL=
